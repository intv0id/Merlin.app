<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>MerlinFrontend</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Merlin.Core/Merlin.Planner/Merlin.Planner.csproj" />
    <ProjectReference Include="Merlin.Core/Merlin.Solvers/Merlin.Solvers.csproj" />
  </ItemGroup>
</Project>
